# Скопируйте в .env.local и при необходимости измените. Реальные секреты в репозиторий не добавляйте.

# Подключение к PostgreSQL (значения по умолчанию совпадают с docker-compose.yml, только для локальной разработки)
DATABASE_URL=postgres://ecolink:ecolink@127.0.0.1:5433/ecolink
# Отдельная база для автотестов (тесты очищают её!)
TEST_DATABASE_URL=postgres://ecolink:ecolink@127.0.0.1:5433/ecolink_test

# Курс USD→KGS для отображения подписки (администратор может переопределить в настройках)
USD_KGS_RATE=87.50
USD_KGS_RATE_DATE=2026-10-19

# Необязательно:
# Пароль демо-аккаунтов при запуске seed (по умолчанию EcoDemo2026). В production не использовать seed.
# DEMO_PASSWORD=
# Показывать код восстановления доступа на экране (демо вместо SMS). Вне production включено по умолчанию.
# DEMO_RESET_CODES=1
